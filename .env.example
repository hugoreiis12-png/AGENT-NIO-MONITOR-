# Copie para .env e preencha. NUNCA comite o .env.
# Segredo NAO vai em YAML -- so o nome da var aqui e no environments.yaml.
#
# Os host abaixo sao EXEMPLO, nao os da sua rede. Os reais estao em
# config/environments.yaml (que e versionado e nao tem segredo). Este arquivo
# antes apontava para 192.168.0.140, que o proprio config registra como
# FECHADO por sonda TCP -- quem copiasse daqui comeca com n8n inacessivel.

# --- n8n ---------------------------------------------------------------------
N8N_API_KEY=
# --- Portainer ---------------------------------------------------------------
# Token de acesso: Portainer -> meu perfil -> API tokens.
PORTAINER_API_KEY=
# Opcional: sobrescreve SO a URL do doctor, para sondar um endereco
# alternativo sem editar o config versionado.
# PORTAINER_URL=https://EXEMPLO:9443

# --- Power Automate (Dataverse) ------------------------------------------------
# Service principal nio-fabric-sp, com um secret SO do monitor (rotacao independente
# do Fabric). Copie o VALUE do secret, nao o Secret ID. A URL do Dataverse fica em
# config/environments.yaml (powerautomate.dataverse_url).
POWERAUTOMATE_TENANT_ID=
POWERAUTOMATE_CLIENT_ID=
POWERAUTOMATE_CLIENT_SECRET=

# --- Email (webhook do n8n) --------------------------------------------------
# A URL real vem de config/environments.yaml (mail.webhook_url).
# MAIL_WEBHOOK_URL=http://EXEMPLO:5678/webhook/ALGUM
# Canal de reserva (SMTP direto, ADR D46). Vazias = reserva sem login; host em environments.yaml (mail.smtp).
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Postgres ----------------------------------------------------------------
# Schema separado. NUNCA o mesmo database do n8n.
DATABASE_DSN=postgresql://usuario:senha@host:5432/hermes

# Testes de integracao (fazem TRUNCATE): base SEPARADA do agente, nome terminando em _test.
# Sem isto os testes de Postgres sao pulados.
DATABASE_DSN_TEST=postgresql://usuario:senha@host:5432/hermes_test

# --- LLM ----------------------------------------------------------------------
# Qwen (vLLM) e configurado em config/environments.yaml (llm.*), nao por variavel.

# --- Operacao ----------------------------------------------------------------
LOG_LEVEL=INFO