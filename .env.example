# Copie para .env e preencha. NUNCA comite o .env.
# Segredo NAO vai em YAML -- so o nome da var aqui e no environments.yaml.

# --- n8n ---------------------------------------------------------------------
N8N_API_KEY=
# --- Portainer ---------------------------------------------------------------
# Token de acesso: Portainer -> meu perfil -> API tokens.
PORTAINER_API_KEY=
PORTAINER_URL=https://192.168.0.140:9443

# --- Email (webhook do n8n) --------------------------------------------------
MAIL_WEBHOOK_URL=http://192.168.0.140:5678

# --- Postgres ----------------------------------------------------------------
# Schema separado. NUNCA o mesmo database do n8n.
DATABASE_DSN=postgresql://usuario:senha@host:5432/hermes

# Testes de integracao (fazem TRUNCATE): base SEPARADA do agente, nome terminando em _test.
# Sem isto os testes de Postgres sao pulados.
DATABASE_DSN_TEST=postgresql://usuario:senha@host:5432/hermes_test

# --- LLM ----------------------------------------------------------------------
# Qwen (vLLM) e configurado em config/environments.yaml (llm.*), nao por variavel.

# --- Operacao ----------------------------------------------------------------
LOG_LEVEL=INFO